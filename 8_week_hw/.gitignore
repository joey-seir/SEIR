# Terraform working directory
.terraform/

# Terraform state files (contain sensitive data)
*.tfstate
*.tfstate.*

# Crash logs
crash.log

# Sensitive variable files
*.tfvars
*.tfvars.json

# CLI configuration files
.terraformrc
terraform.rc

# Override files (local-only configs)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.tfplan

# Dependency lock file (optional — see note below)
.terraform.lock.hcl